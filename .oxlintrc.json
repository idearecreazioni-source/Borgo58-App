{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "oxc"
  ],
  "env": {
    "browser": true,
    "es2024": true
  },
  "globals": {
    "__INDIRIZZI_ACCESSO__": "readonly"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "no-undef": "error"
  },
  "overrides": [
    {
      "files": [
        "scripts/**",
        "*.config.js",
        "tests/**"
      ],
      "env": {
        "node": true,
        "browser": true,
        "es2024": true
      }
    },
    {
      "files": [
        "supabase/functions/**"
      ],
      "globals": {
        "Deno": "readonly",
        "EdgeRuntime": "readonly"
      }
    }
  ],
  "ignorePatterns": [
    "docs/**",
    "dist/**"
  ]
}

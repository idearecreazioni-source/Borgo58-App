# Chiavi dei comandi di copia e ripristino (npm run backup, npm run prova:*).
#
# Copiare questo file in ".env.db" e completarlo. ".env.db" vive SOLO su
# questo computer: e' escluso dal repository e non va mai mandato a
# nessuno. Chi ha questo file puo' leggere e riscrivere tutto il
# gestionale: va trattato come le chiavi del locale.
#
# Dove si prendono i valori: docs/BACKUP.md (paragrafo 2).

# --- Database VERO (solo lettura: da qui esce la copia di sicurezza) ---
DB_URL_PRODUZIONE=
SUPABASE_URL_PRODUZIONE=https://oudjuqbqszisdtwzbxdo.supabase.co
SERVICE_ROLE_PRODUZIONE=

# --- Database di PROVA (qui si prova, si rompe e si rifa') ---
DB_URL_PROVA=
PROVA_ANON_KEY=

# --- Dove finiscono le copie (lasciare vuoto = Desktop\Backup Borgo 58) ---
BACKUP_CARTELLA=

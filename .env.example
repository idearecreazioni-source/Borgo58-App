# =====================================================================
# LE CHIAVI DI BORGO 58 — un file solo
# =====================================================================
#
# COSA FARE: copia questo file in `.env` (senza `.example`) e riempi le
# caselle vuote. Le righe gia' compilate sono giuste cosi'.
#
# 🔴 `.env` NON ENTRA MAI NEL REPOSITORY. Dentro ci sono valori segreti —
#    la chiave che riscrive tutto il database, la password del
#    collegamento diretto, i PIN degli utenti di collaudo. Il divieto e'
#    nel `.gitignore`, non nell'attenzione di chi committa.
#
# ⚠️ PERCHE' UN FILE SOLO, dal 31/08/2026. Prima erano tre (`.env.local`,
#    `.env.test`, `.env.db`), nati in tre momenti diversi e mai per una
#    decisione. Il motivo per cui sembravano inseparabili era che due di
#    loro davano DUE VALORI DIVERSI ALLO STESSO NOME: `VITE_SUPABASE_URL`
#    voleva dire «il locale vero» in uno e «il progetto di prova»
#    nell'altro. La cura non e' tenerli separati: e' dare due nomi a due
#    cose diverse, che e' quello che questo file fa.
#
# ⚠️ E LA SEPARAZIONE NON PROTEGGEVA NIENTE, misurato: le due reti che
#    impediscono di scrivere sul database vero (`soloProva()` in
#    scripts/comune.mjs e il controllo in tests/app/aiuto.js) guardano
#    IL VALORE dell'indirizzo, non da quale file arriva. Continuano a
#    funzionare identiche.
#
# ✅ E IL SEGRETO NON FINISCE NEL SITO — misurato il 31/08 costruendo il
#    sito con questo file pieno di valori finti e cercandoli dentro:
#    di tutto quello che c'e' qui dentro, nel pacchetto pubblicato
#    arrivano SOLO le due righe che cominciano per `VITE_`. La chiave di
#    servizio, la password del database e i PIN di collaudo restano
#    fuori. E' Vite che espone solo cio' che ha quel prefisso: per
#    questo le due righe pubbliche si chiamano cosi' e le altre no.
#
# 🔴 QUESTO FILE E' SOLO CONFIGURAZIONE LOCALE, e vale solo sul computer
#    di Alessio. Fuori di qui NON esiste e non deve esistere:
#      · su GitHub i valori arrivano dai Secrets del repository, che la
#        pipeline passa come variabili d'ambiente ai comandi;
#      · su Cloudflare Pages arrivano dalle variabili d'ambiente del
#        progetto, distinte fra produzione e anteprima — ed e' per
#        questo che l'anteprima di un ramo parla al database di PROVA
#        mentre borgo58.it parla a quello vero (misurato il 31/08).
#    Chi cerca «dove sta scritta la chiave del sito» non la trova qui: la
#    trova nel pannello di Cloudflare.
#
# ✅ E L'AMBIENTE VINCE SEMPRE SUL FILE — misurato, non dedotto: con
#    `VITE_SUPABASE_URL` scritto qui e un valore diverso passato dal
#    comando, nel sito costruito finisce quello del comando. E' cio' che
#    permette a `npm run dev:prova` di aprire il gestionale sul database
#    di prova senza toccare questo file, e alla pipeline di girare senza
#    che questo file esista affatto.
#
# DOVE SI PRENDONO I VALORI: docs/BACKUP.md (paragrafo 2) per il
# database vero, docs/AMBIENTE_PROVA.md per il progetto di prova,
# tests/app/LEGGIMI.md per gli utenti di collaudo.


# ---------------------------------------------------------------------
# 1. IL GESTIONALE — quello che si apre nel browser
# ---------------------------------------------------------------------
# Punta al LOCALE VERO. Sono le uniche due righe che finiscono dentro il
# sito pubblicato, e va bene: la chiave anon e' pubblica per progetto —
# a proteggere i dati sono le regole del database (RLS), non questa
# stringa. Le legge Vite da sole, per il prefisso `VITE_`.
VITE_SUPABASE_URL=https://oudjuqbqszisdtwzbxdo.supabase.co
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------
# 2. IL PROGETTO DI PROVA — usa-e-getta, ricostruibile da zero
# ---------------------------------------------------------------------
# Qui girano le 459 prove automatiche e `npm run dev:prova`. Un guasto
# delle prove non deve poter costare dati veri: se qui compare
# l'indirizzo del progetto vero, le prove si RIFIUTANO di partire.
# ⚠️ Niente prefisso `VITE_`: questi valori non devono finire nel sito.
#    Chi ne ha bisogno (le prove, il gestionale di prova) se li fa
#    passare come variabili d'ambiente al momento di partire — misurato:
#    quello che passa il comando vince su quello che c'e' scritto qui.
PROVA_SUPABASE_URL=
PROVA_SUPABASE_ANON_KEY=
DB_URL_PROVA=

# ---------------------------------------------------------------------
# 3. GLI UTENTI DI COLLAUDO — esistono solo nel progetto di prova
# ---------------------------------------------------------------------
# 🔴 Non sono le credenziali di Alessio, e non devono diventarlo: le
#    credenziali di una persona non si prestano, o non si sa piu' chi ha
#    fatto cosa. Questi due utenti aprono solo il database di prova.
TEST_TITOLARE_EMAIL=test-titolare@borgo58.app
TEST_TITOLARE_PASSWORD=
TEST_STAFF_EMAIL=test-staff@borgo58.app
TEST_STAFF_PASSWORD=

# ---------------------------------------------------------------------
# 4. IL DATABASE VERO — copie, migrazioni, funzioni online
# ---------------------------------------------------------------------
# 🔴 QUESTE DUE RIGHE SONO LE CHIAVI DEL LOCALE. Chi le ha legge e
#    riscrive tutto il gestionale, regole comprese. Non si mandano a
#    nessuno, nemmeno a chi ci sta aiutando: se serve far vedere la
#    configurazione a qualcuno, si fa vedere questo modello, non `.env`.
DB_URL_PRODUZIONE=
SERVICE_ROLE_PRODUZIONE=

# ---------------------------------------------------------------------
# 5. DOVE FINISCONO LE COPIE DI SICUREZZA
# ---------------------------------------------------------------------
# Vuoto = Desktop\Backup Borgo 58.
BACKUP_CARTELLA=

# ---------------------------------------------------------------------
# 6. CLOUDFLARE — la pulizia delle anteprime dei rami
# ---------------------------------------------------------------------
# Serve a `npm run cloudflare`. Arrivato da master il 31/08 con un file
# suo (`.env.cloudflare`): assorbito qui, perche' un quarto file avrebbe
# rimesso in piedi il problema che questo modello esiste per togliere.
#
# 🔴 IL TOKEN SA CANCELLARE SITI. Va creato col solo permesso
#    "Cloudflare Pages: Edit" e nient'altro. Come si crea, click per
#    click: docs/CLOUDFLARE.md, sezione 5.
CLOUDFLARE_API_TOKEN=

# Il numero dell'account: si legge nell'indirizzo del pannello, subito
# dopo dash.cloudflare.com/ — ed e' lo stesso che Cloudflare scrive nei
# suoi messaggi sulle proposte di modifica.
CLOUDFLARE_ACCOUNT_ID=124e479908976a117d12b1daadde0d97

# Il nome del progetto Pages. Si cambia solo se cambia il progetto.
CLOUDFLARE_PROJECT=borgo58-app

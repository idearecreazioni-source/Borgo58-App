# Chiavi per `npm run cloudflare` — la pulizia delle costruzioni su Cloudflare.
# Copiare questo file in `.env.cloudflare` e completarlo.
# `.env.cloudflare` NON va mai committato (gia' escluso da .gitignore).
#
# Come si crea la chiave, click per click: docs/CLOUDFLARE.md, sezione 5.
# Serve il permesso "Cloudflare Pages: Edit" e nient'altro: quella chiave sa
# cancellare siti, e non deve poter fare altro.

# Il token creato da My Profile -> API Tokens -> Create Custom Token
CLOUDFLARE_API_TOKEN=

# Il numero dell'account: si legge nell'indirizzo del pannello, subito dopo
# dash.cloudflare.com/ — ed e' lo stesso che Cloudflare scrive nei suoi
# messaggi sulle proposte di modifica.
CLOUDFLARE_ACCOUNT_ID=124e479908976a117d12b1daadde0d97

# Il nome del progetto Pages. Si cambia solo se un giorno cambia il progetto.
CLOUDFLARE_PROJECT=borgo58-app
